# AIGIQA server paths (branch apps/aigiqa-20261020). Sourced by every wrapper in this directory.
# Owner 2026-10-20: 「数据放 /projects，checkpoint 放 home」. Data and weights live on /projects (data-location rule; the ~2 GB
# AIGIQA download is a one-time exception to the 1.2 TB floor). Every run output (best.pt, G0 output and its best.pt-shaped
# probe, lock + receipts, records, predictions) goes to the home outputs tree AIG_OUT below.
AIG_REPO=/home/infres/yinwang/CS_QMI/ssl_pilot_app_aigiqa
AIG_PKG=$AIG_REPO/apps/VCS_QMI_KD_AIGIQA_Server_Package_v1_20261019
AIG_SERVER=$AIG_REPO/apps/aigiqa_server
AIG_EVIDENCE=$AIG_SERVER/evidence
AIG_ENV=/home/infres/yinwang/anaconda3/envs/vcs_aigiqa_ir
AIG_PY=$AIG_ENV/bin/python
AIG_DATA=/projects/EEG-foundation-model/yinghao/data/agiqa_3k
AIG_PREPARED=$AIG_DATA/prepared/AGIQA-3k
AIG_MODELS=/projects/EEG-foundation-model/yinghao/models/imagereward
AIG_HF_HOME=$AIG_MODELS/hf_home
AIG_BERT_LOCAL=/projects/EEG-foundation-model/yinghao/models/bert-base-uncased
AIG_OUT=/home/infres/yinwang/CS_QMI/outputs_apps/aigiqa_20261020
AIG_PROTOCOL=$AIG_OUT/protocol
AIG_LOCK=$AIG_PROTOCOL/aigiqa_alignment_lock.json
AIG_RECORDS=$AIG_OUT/records
AIG_LOGS=/home/infres/yinwang/CS_QMI/slurm_logs
