diff --git a/solo/methods/vcs.py b/solo/methods/vcs.py
new file mode 100644
index 0000000..3d3b55c
--- /dev/null
+++ b/solo/methods/vcs.py
@@ -0,0 +1,164 @@
+# VCS-QMI port for solo-learn (S2, CS_QMI next round).  Objective and critic replicate
+# CS_QMI/ssl_pilot reference/ssl_core.py (vcs_from_scores, cyclic_negative_indices) and
+# src/vcs_ssl/objectives.py (vcs_pair_loss_negdetach), src/vcs_ssl/models/critic.py (CosineCritic)
+# of the final VCS recipe: cosine critic tanh(a <z1, z2> + b), a0 = 5, b0 = 0, K = 8 distinct nonzero
+# cyclic shifts drawn from a dedicated CPU generator, shifted partner detached, loss = -J with the
+# positive and negative distributions averaged separately; no CS log transform, J not clipped.
+
+from typing import Any, Dict, List, Sequence
+
+import omegaconf
+import torch
+import torch.nn as nn
+import torch.nn.functional as F
+from solo.methods.base import BaseMethod
+
+
+def vcs_from_scores(t_pos: torch.Tensor, t_neg: torch.Tensor) -> Dict[str, torch.Tensor]:
+    """Each distribution averaged separately (reference/ssl_core.py). loss = -J."""
+    mp, mq, sp, sq = t_pos.mean(), t_neg.mean(), t_pos.square().mean(), t_neg.square().mean()
+    j = mp - mq - 0.5 * sp - 0.5 * sq
+    return {
+        "loss": -j,
+        "J_raw": j,
+        "t_pos_mean": mp,
+        "t_neg_mean": mq,
+        "sat_pos_frac": (t_pos.abs() > 0.95).float().mean(),
+        "sat_neg_frac": (t_neg.abs() > 0.95).float().mean(),
+    }
+
+
+def cyclic_negative_indices(batch_size: int, k: int, generator: torch.Generator, device) -> torch.Tensor:
+    """[K,B] partner indices with K distinct nonzero cyclic shifts (reference/ssl_core.py)."""
+    if not 1 <= k <= batch_size - 1:
+        raise ValueError("require 1 <= k <= batch_size - 1")
+    shifts = torch.randperm(batch_size - 1, generator=generator, device="cpu")[:k] + 1
+    base = torch.arange(batch_size, device=device)
+    return (base[None, :] + shifts.to(device)[:, None]) % batch_size
+
+
+class CosineCritic(nn.Module):
+    """tanh(a * <z1, z2> + b) on L2-normalised projector outputs.  a, b are stored with shape [1] so that
+    solo-learn's LARS (exclude_bias_n_norm) skips the trust-ratio scaling and weight decay for them: they
+    get plain SGD-momentum steps at the scheduled lr (disclosed in the P75 prereg)."""
+
+    def __init__(self, scale_init: float = 5.0) -> None:
+        super().__init__()
+        self.scale = nn.Parameter(torch.tensor([float(scale_init)]))
+        self.bias = nn.Parameter(torch.tensor([0.0]))
+
+    def forward(self, left: torch.Tensor, right: torch.Tensor) -> torch.Tensor:
+        return torch.tanh(self.scale * (left * right).sum(-1) + self.bias)
+
+
+class VCS(BaseMethod):
+    def __init__(self, cfg: omegaconf.DictConfig):
+        """VCS-QMI (J objective, M = (P+Q)/2 mixture reference, tanh critic).
+
+        Extra cfg settings:
+            method_kwargs:
+                proj_output_dim (int), proj_hidden_dim (int): projector as in solo-learn SimCLR.
+                k (int): number of cyclic-shift negatives per anchor (8).
+                critic_scale_init (float): a0 (5.0).
+                negative_detach (bool): detach the shifted partner in negative pairs (True).
+                pair_seed_offset (int): the pairing generator is seeded with cfg.seed + offset.
+        """
+
+        super().__init__(cfg)
+
+        proj_hidden_dim: int = cfg.method_kwargs.proj_hidden_dim
+        proj_output_dim: int = cfg.method_kwargs.proj_output_dim
+        self.k: int = cfg.method_kwargs.k
+        self.negative_detach: bool = cfg.method_kwargs.negative_detach
+
+        # projector structure of the ssl_pilot VCS recipe (hidden Linear without bias -> BN -> ReLU -> Linear with
+        # bias, no output BN) at the protocol's 2048/256 width.  solo-learn's SimCLR head (Linear-ReLU-Linear, no BN)
+        # is not usable for a bounded cosine critic: at initialisation all post-ReLU features share one direction,
+        # cos ~ 1 for every pair, tanh(5 cos) saturates for positives and negatives alike (CPU smoke 1013082:
+        # t_pos = t_neg = 0.9996, J = -0.999) and the gradient (1 - T^2) vanishes.
+        if cfg.method_kwargs.proj_hidden_bn:
+            self.projector = nn.Sequential(
+                nn.Linear(self.features_dim, proj_hidden_dim, bias=False),
+                nn.BatchNorm1d(proj_hidden_dim),
+                nn.ReLU(),
+                nn.Linear(proj_hidden_dim, proj_output_dim),
+            )
+        else:
+            self.projector = nn.Sequential(
+                nn.Linear(self.features_dim, proj_hidden_dim),
+                nn.ReLU(),
+                nn.Linear(proj_hidden_dim, proj_output_dim),
+            )
+        self.critic = CosineCritic(cfg.method_kwargs.critic_scale_init)
+        # dedicated CPU pairing stream (not checkpointed: after a resume the shifts continue from a
+        # re-seeded stream, which only changes which shifts are drawn, not their distribution)
+        self.pair_generator = torch.Generator().manual_seed(int(cfg.seed) + int(cfg.method_kwargs.pair_seed_offset))
+
+    @staticmethod
+    def add_and_assert_specific_cfg(cfg: omegaconf.DictConfig) -> omegaconf.DictConfig:
+        cfg = super(VCS, VCS).add_and_assert_specific_cfg(cfg)
+
+        assert not omegaconf.OmegaConf.is_missing(cfg, "method_kwargs.proj_output_dim")
+        assert not omegaconf.OmegaConf.is_missing(cfg, "method_kwargs.proj_hidden_dim")
+        cfg.method_kwargs.k = omegaconf.OmegaConf.select(cfg, "method_kwargs.k", default=8)
+        cfg.method_kwargs.critic_scale_init = omegaconf.OmegaConf.select(
+            cfg, "method_kwargs.critic_scale_init", default=5.0
+        )
+        cfg.method_kwargs.negative_detach = omegaconf.OmegaConf.select(
+            cfg, "method_kwargs.negative_detach", default=True
+        )
+        cfg.method_kwargs.proj_hidden_bn = omegaconf.OmegaConf.select(
+            cfg, "method_kwargs.proj_hidden_bn", default=True
+        )
+        cfg.method_kwargs.pair_seed_offset = omegaconf.OmegaConf.select(
+            cfg, "method_kwargs.pair_seed_offset", default=100003
+        )
+        return cfg
+
+    @property
+    def learnable_params(self) -> List[dict]:
+        extra_learnable_params = [
+            {"name": "projector", "params": self.projector.parameters()},
+            {"name": "critic", "params": self.critic.parameters(), "weight_decay": 0.0},
+        ]
+        return super().learnable_params + extra_learnable_params
+
+    def forward(self, X: torch.tensor) -> Dict[str, Any]:
+        out = super().forward(X)
+        z = self.projector(out["feats"])
+        out.update({"z": z})
+        return out
+
+    def vcs_loss(self, z1: torch.Tensor, z2: torch.Tensor) -> Dict[str, torch.Tensor]:
+        # fp32 critic on L2-normalised projector outputs (the run uses 16-mixed autocast)
+        z1 = F.normalize(z1.float(), dim=1, eps=1e-8)
+        z2 = F.normalize(z2.float(), dim=1, eps=1e-8)
+        with torch.autocast(device_type=z1.device.type, enabled=False):
+            idx = cyclic_negative_indices(len(z1), self.k, self.pair_generator, z1.device)
+            t_pos = self.critic(z1, z2)
+            left = z1.unsqueeze(0).expand(self.k, -1, -1).reshape(-1, z1.shape[1])
+            partner = z2.detach() if self.negative_detach else z2
+            right = partner[idx].reshape(-1, z2.shape[1])
+            t_neg = self.critic(left, right)
+            return vcs_from_scores(t_pos, t_neg)
+
+    def training_step(self, batch: Sequence[Any], batch_idx: int) -> torch.Tensor:
+        out = super().training_step(batch, batch_idx)
+        class_loss = out["loss"]
+        z1, z2 = out["z"][:2]
+
+        s = self.vcs_loss(z1, z2)
+        self.log_dict(
+            {
+                "train_vcs_J": s["J_raw"],
+                "train_vcs_t_pos": s["t_pos_mean"],
+                "train_vcs_t_neg": s["t_neg_mean"],
+                "train_vcs_sat_pos": s["sat_pos_frac"],
+                "train_vcs_sat_neg": s["sat_neg_frac"],
+                "critic_a": self.critic.scale.detach()[0],
+                "critic_b": self.critic.bias.detach()[0],
+            },
+            on_epoch=True,
+            sync_dist=True,
+        )
+        return s["loss"] + class_loss
