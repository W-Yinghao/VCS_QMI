+def _s2_final_metrics(cfg, trainer, model, val_loader):
+    """CS_QMI S2 (P75): the official test split (solo-learn's CIFAR 'val') is evaluated once, at the end of
+    epoch max_epochs (check_val_every_n_epoch = max_epochs, num_sanity_val_steps = 0).  If the run finished
+    but that validation pass is missing (e.g. a resume from the final checkpoint), run it exactly once here.
+    Writes <checkpoint.dir>/final_metrics.json; a later invocation that finds the file does nothing."""
+    import json
+
+    if os.environ.get("S2_NO_TEST") == "1":  # smoke runs: never evaluate the official test split
+        return
+    out = os.path.join(cfg.checkpoint.dir, "final_metrics.json")
+    if os.path.exists(out) or trainer.current_epoch < cfg.max_epochs:
+        return
+    metrics = {k: float(v) for k, v in trainer.callback_metrics.items()}
+    source = "fit_final_epoch_validation"
+    if "val_acc1" not in metrics:
+        metrics.update({k: float(v) for k, v in trainer.validate(model, val_loader)[0].items()})
+        source = "post_fit_single_validate"
+    if trainer.is_global_zero:
+        json.dump({"source": source, "epoch": int(trainer.current_epoch), "metrics": metrics,
+                   "method": cfg.method, "seed": int(cfg.seed), "name": cfg.name}, open(out, "w"), indent=1)
 
 
