+@torch.no_grad()
+def true_target_t2i(net, cap_gidx, mean, stats=None):
+    """R27-O3 encoder target: T[i] = current-peer re-encoding (r27_interface.reencode, the candidate rule) of the TRUE
+    image of query caption i, unit norm, stop-grad. Unique true IDs are encoded once and gathered (rows sharing a true
+    image get the identical vector). Logs rows / rows whose true image is shared with another row of the batch."""
+    _check_id_space()
+    from r27_interface import reencode
+    tru = true_image(cap_gidx.long())
+    cols, inv, cnt = torch.unique(tru, return_inverse=True, return_counts=True)
+    Yt = reencode(net, 't2i', cols, mean)
+    T = Yt[inv]
+    dup = cnt[inv] > 1
+    if stats is not None:
+        stats['cnt_t2i_o3_rows'] += int(tru.numel())
+        stats['cnt_t2i_o3_dup_rows'] += int(dup.sum())
+        stats['cnt_t2i_o3_unique_targets'] += int(cols.numel())
+        stats['t2i_o3_dup_frac'] += float(dup.double().mean())
+    return T, dict(truth=tru, cols=cols, inv=inv, dup=dup)
