+def margin(Smat):
+    """mean_i (S_ii - max_{j != i} S_ij) of a query x target score matrix (task margin diagnostic)."""
+    d = Smat.diagonal()
+    off = Smat - torch.diag_embed(torch.full_like(d, float('inf')))
+    return float((d - off.max(1).values).mean())
+
