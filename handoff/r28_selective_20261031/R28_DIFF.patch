+AFF_FALLBACK = ('R1/R2 only: the residual is not fitted and r = 0 for the whole stage, so alpha_score = softmax(16 s) '
+                '(exactly the G1 score readout); counted in rstage_aff_fallback. Same rule for both arms.')
