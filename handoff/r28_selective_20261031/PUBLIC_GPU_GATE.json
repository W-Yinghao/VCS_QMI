  "config": {
    "AFF_A0": 1.0,
    "AFF_B0": 0.0,
    "AFF_CHUNK": 2048,
    "AFF_FALLBACK": "R1/R2 only: the residual is not fitted and r = 0 for the whole stage, so alpha_score = softmax(16 s) (exactly the G1 score readout); counted in rstage_aff_fallback. Same rule for both arms.",
    "AFF_MAX_ITERS": 60,
    "AFF_RULE": "per peer stage, on the stage fit P (teacher coordinates, the same pairs that fit the residual) and the FULL empirical product of its two marginals incl. the diagonal (all n_fit x n_fit caption/image pairs): minimize the balanced logistic loss E_P softplus(-2 g0) + E_Q softplus(2 g0) over (a, b) (Platt-type scalar calibration of 0.5 log(p/q), convex; the diagonal is in both P and Q so the optimum is finite); damped Newton with Armijo backtracking, float64 reductions. a, b are then frozen and only the residual is fitted.",
    "AFF_TOL": 1e-09,
    "A_MIN": 1.0,
    "BATCH": 128,
    "BETA_COS": 16.0,
    "BETA_HEAD": 2.0,
    "CAL_RULE": "pool = stage P rows (teacher high-confidence labeled rows, observed pairing) NOT used by the head/residual fit or held-out sets; observed-image IDs of the pool shuffled (stage generator) and split in half -> fit / report groups (no observed image in both); rows of each group shuffled, first N_CAL_FIT / N_CAL_REP taken (rounded down to 128). Each row: query = its caption in teacher coordinates (unaugmented, centered by its 128-row chunk mean); candidates = the ACTUAL C_mix rule (r27cs_sources.unique_topk + mix_3a_2b on the teacher queue) with the query's own queue record(s) (slot caption ID == query caption ID) excluded from BOTH routes (direct-copy channel; same for all arms); rows short of 5 unique IDs dropped. weak label = 1[observed image ID in the 5 candidates]; the observed item is never inserted. Logistic regression on U_FEATURES + intercept, ridge on the weights only, Newton/IRLS float64 to convergence.",
    "CAL_SEED_OFFSET": 31,
    "ECE_BINS": 10,
    "FROZEN": true,
    "HARD_RULE": "each held-out P caption (the head held-out set): its observed image + the 4 other distinct observed images of the held-out pool with the highest teacher cosine (= the R27-Q trial calibration set); logged per stage: observed top-1 / mean rank / NLL under the arm score readout",
    "HIDDEN": 256,
    "LOGIT_MAX_ITERS": 100,
    "LOGIT_TOL": 1e-10,
    "LR": 0.001,
    "MIN_CLASS": 64,
    "N_CAL_FIT": 4096,
    "N_CAL_REP": 2048,
    "RESIDUAL_INIT": "PairHead default init under torch.manual_seed(stage_seed+17) (= the Q2 head init), then the LAST layer (l2 weight and bias) set to zero -> r_phi == 0 at fit start",
    "RIDGE": 0.0001,
    "STEPS": 200,
    "U_FALLBACK": "intercept-only logistic: u = the calibration-fit weak-label rate (constant for the stage; 0 or 1 if one class is empty); used when the calibration-fit split has < MIN_CLASS rows of a class, or the Newton fit is non-finite / not converged. Counted in rstage_u_fallback. Same rule for all arms.",
    "U_FEATURES": [
      "best_cos",
      "ab_overlap",
      "ab_top1_agree"
    ],
    "U_FEATURE_DEF": {
      "best_cos": "max over the K candidates of the teacher cosine q.y (R27-Q teacher coordinates; the Q1 score)",
      "ab_overlap": "|A5 & B5| / 5: overlap of the two C_mix routes' unique top-5 image-ID lists (A: query . teacher text bank -> partner observed image IDs; B: query . teacher image bank)",
      "ab_top1_agree": "1[A route top-1 ID == B route top-1 ID]"
    }
  },
