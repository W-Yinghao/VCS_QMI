      "label",
      "path",
      "state_sha256",
      "raw_epoch",
      "completed_cotrain_epochs",
      "cond",
      "seed",
      "state_opt_seed",
      "state_opt_noise_ratio",
      "state_opt_r29_arm",
      "state_opt_r30"
    ],
    "meta.endpoint": [
