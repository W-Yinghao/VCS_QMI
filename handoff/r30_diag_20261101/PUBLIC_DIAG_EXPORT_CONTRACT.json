    "R29 saved state": "r29_<cell>__<arm>@raw<E> (raw co-train epoch E; completed = E+1)",
    "R30 parent (E0)": "<parent_id> from WARMUP_PARENTS.csv (completed 0)",
    "R30 fixed E10": "<unit_id> from MATRIX.csv, state_completed10.pt (completed 10, raw 9)",
    "R30 fixed E40": "<unit_id> from MATRIX.csv (FULL40), state_last.pt with DONE.json (completed 40, raw 39)"
  },
  "record": {
    "meta.identity": [
